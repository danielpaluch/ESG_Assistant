{
  "info": {
    "name": "ESG Assistant Emissions",
    "_postman_id": "7b2c7d1f-4c3b-4e1f-9f0f-1a3c2f4a8b9c",
    "description": "Example requests for emissions endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "REPLACE_WITH_JWT"
    }
  ],
  "item": [
    {
      "name": "Fetch emission properties",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/emissions/properties",
          "host": ["{{baseUrl}}"],
          "path": ["emissions", "properties"]
        }
      }
    },
    {
      "name": "List emission reports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/emissions",
          "host": ["{{baseUrl}}"],
          "path": ["emissions"]
        }
      }
    },
    {
      "name": "Get emissions by type (fuel)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/emissions/fuel",
          "host": ["{{baseUrl}}"],
          "path": ["emissions", "fuel"]
        }
      }
    },
    {
      "name": "Create emission report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Q1 Emissions\",\n  \"description\": \"Example emission report\",\n  \"company_id\": \"REPLACE_WITH_COMPANY_ID\",\n  \"emissions\": [\n    {\n      \"type\": \"fuel\",\n      \"amount\": 1000,\n      \"category\": \"Gaseous fuels\",\n      \"unit\": \"litres\",\n      \"fuel\": \"Butane\"\n    },\n    {\n      \"type\": \"electric_energy\",\n      \"amount\": 2500,\n      \"category\": \"Electricity generated\",\n      \"unit\": \"kWh\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/emissions",
          "host": ["{{baseUrl}}"],
          "path": ["emissions"]
        }
      }
    }
  ]
}
